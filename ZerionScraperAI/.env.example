# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
# SQLite database file (created on first migrate)
DB_PATH=./data/leads.db
# pino level: trace|debug|info|warn|error
LOG_LEVEL=info

# --- Lead source (F2 ingestion) ---
# apify (production) | fixture (local testing)
LEAD_SOURCE=apify
APIFY_TOKEN=
# Only used when LEAD_SOURCE=fixture
FIXTURE_PATH=./test/fixtures/leads.sample.json

# --- Segmentation / audit (V3 days 4-5) ---
# Serper confirms no-website leads (2,500 free queries) — without it the
# no_website segment is provisional (Maps data only).
SERPER_API_KEY=

# --- LLM: pain mining + call card (V3 day 6) ---
# DeepSeek vía OpenRouter (formato OpenAI-compatible /chat/completions).
# Consola: https://openrouter.ai/settings/keys
# Modelo default: deepseek/deepseek-v4-flash-0731 (DeepSeek V4 Flash,
# lanzado 31 jul / 1 ago 2026). El alias "-latest" de OpenRouter NO es un ID
# válido; usa siempre el ID con fecha (0731).
# El id usa el formato "proveedor/modelo" de OpenRouter.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- v-later: only if the EMAIL channel is ever added (V3 dropped it) ---
REOON_API_KEY=
INSTANTLY_API_KEY=

# --- Zerion CRM integration -------------------------------------------------
# The leads generated each run "fall into" the CRM as prospectos (temperatura
# "nuevo") assigned to a Staff member, ready for cold calling. Configure all
# three to enable; leave blank to disable.
#
# The CRM's Supabase project URL (same one the CRM app uses).
CRM_SUPABASE_URL=
# service_role key (Supabase → Project Settings → API). SERVER-SIDE ONLY —
# it bypasses RLS. Never commit it or ship it to a browser.
CRM_SUPABASE_SERVICE_ROLE_KEY=
# Email of the CRM Staff user who receives the leads (must exist in Equipo).
CRM_ASSIGN_TO_EMAIL=
# Auto-push after every `run` (default true). Set false to only push manually
# with `npm run cli crm:push --all`.
CRM_AUTOPUSH=true