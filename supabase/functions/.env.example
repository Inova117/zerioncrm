# ============================================================================
# SECRETS DE LAS EDGE FUNCTIONS (servidor) — Claude, Deepgram, Apify, Kimi.
#
# Estas claves NUNCA tocan el navegador: viven solo en Supabase.
#
# ── PRODUCCIÓN (lo normal) ──────────────────────────────────────────────────
# NO se usa este archivo: cada clave se sube como secret con el CLI:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-xxxxx
#   supabase secrets set DEEPGRAM_API_KEY=xxxxx
#
# y luego se (re)despliegan las funciones:
#
#   supabase functions deploy copilot
#   supabase functions deploy deepgram-token
#   supabase functions deploy find-leads
#
# Verifica lo configurado con:  supabase secrets list
#
# ── DESARROLLO LOCAL (opcional) ─────────────────────────────────────────────
# Copia este archivo a supabase/functions/.env (gitignoreado) y corre:
#
#   supabase functions serve --env-file supabase/functions/.env
# ============================================================================

# --- Sales Copilot (función: copilot) ---------------------------------------
# Consola: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Opcionales — modelos del copilot:
# Briefing pre-llamada y resumen al colgar (calidad máxima):
# COPILOT_MODEL=claude-opus-4-8
# Sugerencias EN VIVO (latencia mínima; default ya es Haiku 4.5):
# COPILOT_MODEL_SUGGEST=claude-haiku-4-5

# Opcionales — proveedor alterno OpenAI-compatible para A/B (ej. Kimi K3):
# COPILOT_PROVIDER=kimi
# KIMI_API_KEY=sk-xxxxx
# KIMI_MODEL=kimi-k3
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# --- Transcripción premium (función: deepgram-token) ------------------------
# Consola: https://console.deepgram.com → API Keys (usa la master/admin key;
# el navegador solo recibe tokens temporales de ~60s).
# Sin esta clave, el copilot cae solo a la Web Speech API del navegador.
DEEPGRAM_API_KEY=xxxxx

# Opcional — vida del token temporal en segundos (default 60, máx 3600):
# DEEPGRAM_TOKEN_TTL=60

# --- Lead Finder (función: find-leads) ---------------------------------------
# Consola: https://console.apify.com → Settings → Integrations
APIFY_TOKEN=apify_api_xxxxx
